# Gmail account used to send form and referral messages.
GMAIL_ADDRESS=
# Gmail app password used by the Python mail handlers.
GMAIL_APP_PASSWORD=
# Destination for contact and get started submissions.
RECIPIENT_EMAIL=
# Shared password checked by the board referral handler.
BOARD_REFERRAL_PASSWORD=
# Canonical site URL used for metadata, robots.txt, and the sitemap.
PUBLIC_SITE_URL=
# Vercel deployment hostname used when PUBLIC_SITE_URL is unset.
VERCEL_URL=
# Astro supplied production mode flag used when rendering content.
PROD=
