---
import { DONATE_URL, FDACS_CONTACT, FDACS_DISCLOSURE, FDACS_REGISTRATION_NUMBER } from "../../config/giving";

const footerNav = [
  { text: "About", href: "/about" },
  { text: "Services", href: "/services" },
  { text: "Employers", href: "/employers" },
  { text: "Find a Partner Clinic", href: "/providers" },
  { text: "Blog", href: "/blog" },
  { text: "Get Started", href: "/get-started" },
  { text: "Contact", href: "/contact" },
  ...(DONATE_URL ? [{ text: "Donate", href: DONATE_URL, external: true }] : []),
];

const legalNav = [
  { text: "Privacy Policy", href: "/privacy-policy" },
  { text: "Terms of Service", href: "/terms" },
];
---

<footer class="bg-bema-green py-14 text-bema-white">
  <div class="container">
    <div class="grid gap-10 md:grid-cols-3">
      <div>
        <a href="/" class="font-display text-3xl font-bold text-bema-white" aria-label="BEMA home">BEMA</a>
        <p class="mt-5 max-w-sm text-bema-white/85">BEMA exists so that working families in Florida never have to choose between the care they need and the life they are trying to build.</p>
        <p class="mt-5 text-sm font-medium text-bema-white">A Florida 501(c)(3) Nonprofit Organization</p>
        <!-- TODO: Add EIN and registration number post-incorporation -->{DONATE_URL && FDACS_DISCLOSURE && FDACS_REGISTRATION_NUMBER && FDACS_CONTACT && (
          <div class="mt-6 max-w-sm space-y-2 text-sm leading-6 text-bema-white/85">
            <p class="uppercase">{FDACS_DISCLOSURE}</p>
            <p>{FDACS_REGISTRATION_NUMBER}</p>
            <p>{FDACS_CONTACT}</p>
          </div>
        )}
      </div>

      <nav aria-label="Footer navigation">
        <h2 class="font-body text-lg font-semibold text-bema-white">Navigation</h2>
        <ul class="mt-5 space-y-3">
          {footerNav.map((item) => (
            <li>
              <a
                class="text-bema-white/85 transition-colors hover:text-bema-khaki"
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >{item.text}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <h2 class="font-body text-lg font-semibold text-bema-white">Legal and Info</h2>
        <ul class="mt-5 space-y-3">
          {legalNav.map((item) => (
            <li>
              <a class="text-bema-white/85 transition-colors hover:text-bema-khaki" href={item.href}>{item.text}</a>
            </li>
          ))}
          <li>BEMA HEALTH INCORPORATED</li>
          <li>(689) 325-6672</li>
          <li>580 Lexington Green Lane, Sanford, FL 32771</li>
          <li>support@bemahealth.org</li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-bema-khaki/40 pt-6 text-sm text-bema-white/80 md:flex-row md:items-center md:justify-between">
      <p>&copy; 2026 BEMA Health Incorporated. All rights reserved.</p>
      <p>Created by Poiema Health Group</p>
    </div>
  </div>
</footer>
