---
import { getCollection } from "astro:content";

export interface Props {
  title: string;
  description: string;
  image?: {
    url: string;
    alt: string;
  };
  type?: "website" | "article";
  canonicalUrl?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = {
    url: "/favicon.svg",
    alt: "BEMA Health",
  },
  type = "website",
  canonicalUrl,
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString() || "https://bema-website-tau.vercel.app";
const canonicalURL = canonicalUrl || new URL(Astro.url.pathname, siteUrl).toString();
const imageURL = new URL(image.url, siteUrl).toString();

const articleSlug = Astro.url.pathname.replace(/^\/blog\//, "").replace(/\/$/, "");
const articleEntry = type === "article"
  ? (await getCollection("blog")).find((entry) => entry.slug === articleSlug)
  : undefined;
const articleTitle = articleEntry?.data.title || title.replace(/ \| BEMA.*$/, "");
const articleSources = import.meta.glob("/src/content/blog/**/*.md", {
  query: "?raw", import: "default", eager: true,
});
const articleSource = articleEntry
  ? String(articleSources[`/src/content/blog/${articleEntry.id}`] || "").split("---")[1] || ""
  : "";
const hasAuthor = /^author\s*:/m.test(articleSource);
const hasPublicationDate = /^pubDate\s*:/m.test(articleSource);

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "BEMA Health Incorporated",
  description: "BEMA Health Incorporated is a Florida nonprofit organization that coordinates access to direct primary care, eye care, and mental health services for working individuals and families.",
  url: siteUrl,
  nonprofitStatus: "Nonprofit501c3",
  areaServed: {
    "@type": "State",
    name: "Florida",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    telephone: "+1-689-325-6672",
    email: "support@bemahealth.org",
    areaServed: "US-FL",
    availableLanguage: "English",
  },
};

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: articleTitle,
  ...(hasAuthor && articleEntry?.data.author ? {
    author: { "@type": "Organization", name: articleEntry.data.author },
  } : {}),
  ...(hasPublicationDate && articleEntry?.data.pubDate ? {
    datePublished: articleEntry.data.pubDate.toISOString(),
  } : {}),
  image: imageURL,
  description,
  publisher: {
    "@type": "Organization",
    name: "BEMA Health Incorporated",
  },
  url: canonicalURL,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL,
  },
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "BEMA Health",
  url: siteUrl,
  publisher: {
    "@type": "NGO",
    name: "BEMA Health Incorporated",
  },
};
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonicalURL} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={image.alt} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
<meta property="twitter:image:alt" content={image.alt} />

<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{type === "article" && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
