---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/Sections/PageHeader.astro";
import Button from "../components/UI/Button.astro";

const faqs = [1, 2, 3, 4, 5];
---

<BaseLayout
  title="Get Started | BEMA - Healthcare Access for Florida's Working Families"
  description="Ready to get started with BEMA Health? Learn how to connect your family or team to affordable, coordinated healthcare in Florida."
>
  <PageHeader
    title="This is where accessing your healthcare is easy."
    subtitle="Connect now and a member of the BEMA team will walk you through how membership works, what services are available in your area, and what your next step looks like."
    imageSrc="/images/home-who-we-serve.jpg"
    imageAlt="A working adult in a bright Florida setting looking relaxed and hopeful, warm and approachable, not clinical."
  />

  <section class="section-pad bg-bema-white">
    <div class="container">
      <div class="mb-12 max-w-3xl">
        <p class="eyebrow">How to get started</p>
        <h2>Three steps to getting the care you deserve.</h2>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {[1, 2, 3].map((step) => (
          <article class="card p-6">
            <div class="mb-6 flex h-14 w-14 items-center justify-center rounded-md bg-bema-green font-semibold text-bema-white">{step}</div>
            <h3 class="text-2xl">{step === 1 ? "Reach out to the BEMA team." : step === 2 ? "We find the right partner clinic for you." : "Walk in as a member and get the care you need."}</h3>
            <p class="mt-4 text-bema-green/85">{step === 1 ? "Fill out the contact form or give us a call and a BEMA team member will get back to you promptly. There is no paperwork, no commitment, and no pressure at this stage." : step === 2 ? "BEMA reviews your needs and connects you to the right partner clinic in your area for the services you are looking for. We handle the coordination so you do not have to figure out where to go or who to call." : "Your partner clinic is expecting you. Show up, be seen, and leave without a surprise bill waiting for you on the other side."}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-pad bg-bema-white">
    <div class="container">
      <div class="mb-10 max-w-3xl">
        <p class="eyebrow">Get Started</p>
        <h2>Tell us a little about yourself.</h2>
      </div>

      <div class="mb-8 flex flex-col gap-3 sm:flex-row">
        <button
          type="button"
          id="toggle-individual"
          data-form-toggle="individual"
          class="rounded-md border border-bema-green bg-bema-green px-5 py-3 font-body font-medium text-bema-white transition-colors duration-200"
        >
          I'm an Individual.
        </button>
        <button
          type="button"
          id="toggle-employer"
          data-form-toggle="employer"
          class="rounded-md border border-bema-green bg-transparent px-5 py-3 font-body font-medium text-bema-green transition-colors duration-200"
        >
          I'm an Employer.
        </button>
      </div>

      <div id="form-individual" class="block max-w-4xl">
        <form id="individual-get-started-form" action="#" class="card space-y-6 p-6 md:p-8">
          <input type="hidden" name="form_type" value="individual" />

          <div>
            <label for="individual-name" class="mb-2 block text-sm font-medium text-bema-green">Name</label>
            <input id="individual-name" name="name" type="text" required class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <div>
            <label for="individual-email" class="mb-2 block text-sm font-medium text-bema-green">Email</label>
            <input id="individual-email" name="email" type="email" required class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <div>
            <label for="individual-phone" class="mb-2 block text-sm font-medium text-bema-green">Phone (optional)</label>
            <input id="individual-phone" name="phone" type="tel" class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <div>
            <label for="individual-zip-code" class="mb-2 block text-sm font-medium text-bema-green">ZIP Code (optional)</label>
            <input id="individual-zip-code" name="zip_code" type="text" class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <fieldset>
            <legend class="mb-3 block text-sm font-medium text-bema-green">Who is this for?</legend>
            <div class="grid gap-3 sm:grid-cols-3">
              {["Adult", "Child", "Family"].map((option) => (
                <label class="radio-card cursor-pointer rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-center font-body font-medium text-bema-green transition-colors duration-200">
                  <input class="sr-only" type="radio" name="who_for" value={option} required />
                  <span>{option}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div id="individual-total-count-wrap" class="hidden">
            <label for="individual-total-count" class="mb-2 block text-sm font-medium text-bema-green">How many people total?</label>
            <input id="individual-total-count" name="total_count" type="number" min="1" class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <fieldset>
            <legend class="mb-3 block text-sm font-medium text-bema-green">Preferred method of contact</legend>
            <div class="grid gap-3 sm:grid-cols-3">
              {["Text", "Email", "Call"].map((option) => (
                <label class="contact-method-card cursor-pointer rounded-md border border-bema-green bg-transparent px-4 py-3 text-center font-body font-medium text-bema-green transition-colors duration-200">
                  <input class="sr-only" type="checkbox" name="preferred_contact" value={option} />
                  <span>{option}</span>
                </label>
              ))}
            </div>
            <p class="preferred-contact-error mt-3 hidden text-sm font-medium text-bema-green">Please select at least one preferred contact method.</p>
          </fieldset>

          <div>
            <label for="individual-message" class="mb-2 block text-sm font-medium text-bema-green">Anything else we should know? (optional)</label>
            <textarea id="individual-message" name="message" rows="4" class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green"></textarea>
            <p class="mt-3 rounded-md border border-bema-khaki/40 bg-bema-khaki-light/20 p-3 text-sm font-medium text-bema-green">
              Please do not include personal health information in this form.
            </p>
          </div>

          <Button type="submit">Send My Request</Button>
          <p class="form-submit-error hidden text-sm font-medium text-bema-green">
            Something went wrong. Please try again or contact us directly at bema.healthalliance@gmail.com.
          </p>
        </form>
        <div class="form-success card mt-8 hidden p-6 text-bema-green" role="status">
          Thank you for reaching out. A member of the BEMA team will be in touch with you shortly using your preferred contact method.
        </div>
      </div>

      <div id="form-employer" class="hidden max-w-4xl">
        <form id="employer-get-started-form" action="#" class="card space-y-6 p-6 md:p-8">
          <input type="hidden" name="form_type" value="employer" />

          <div>
            <label for="employer-contact-name" class="mb-2 block text-sm font-medium text-bema-green">Contact Name</label>
            <input id="employer-contact-name" name="contact_name" type="text" required class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <div>
            <label for="employer-business-name" class="mb-2 block text-sm font-medium text-bema-green">Business Name</label>
            <input id="employer-business-name" name="business_name" type="text" required class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <div>
            <label for="employer-email" class="mb-2 block text-sm font-medium text-bema-green">Email</label>
            <input id="employer-email" name="email" type="email" required class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <div>
            <label for="employer-phone" class="mb-2 block text-sm font-medium text-bema-green">Phone (optional)</label>
            <input id="employer-phone" name="phone" type="tel" class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <div>
            <label for="employer-employee-count" class="mb-2 block text-sm font-medium text-bema-green">Number of Employees</label>
            <input id="employer-employee-count" name="employee_count" type="number" min="1" required class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green" />
          </div>

          <fieldset>
            <legend class="mb-3 block text-sm font-medium text-bema-green">Work Arrangement</legend>
            <div class="grid gap-3 sm:grid-cols-3">
              {["On-site", "Remote", "Hybrid"].map((option) => (
                <label class="radio-card cursor-pointer rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-center font-body font-medium text-bema-green transition-colors duration-200">
                  <input class="sr-only" type="radio" name="work_arrangement" value={option} required />
                  <span>{option}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend class="mb-3 block text-sm font-medium text-bema-green">Preferred method of contact</legend>
            <div class="grid gap-3 sm:grid-cols-3">
              {["Text", "Email", "Call"].map((option) => (
                <label class="contact-method-card cursor-pointer rounded-md border border-bema-green bg-transparent px-4 py-3 text-center font-body font-medium text-bema-green transition-colors duration-200">
                  <input class="sr-only" type="checkbox" name="preferred_contact" value={option} />
                  <span>{option}</span>
                </label>
              ))}
            </div>
            <p class="preferred-contact-error mt-3 hidden text-sm font-medium text-bema-green">Please select at least one preferred contact method.</p>
          </fieldset>

          <div>
            <label for="employer-message" class="mb-2 block text-sm font-medium text-bema-green">Anything else we should know? (optional)</label>
            <textarea id="employer-message" name="message" rows="4" class="w-full rounded-md border border-bema-khaki/60 bg-bema-white px-4 py-3 text-bema-green"></textarea>
            <p class="mt-3 rounded-md border border-bema-khaki/40 bg-bema-khaki-light/20 p-3 text-sm font-medium text-bema-green">
              Please do not include personal health information in this form.
            </p>
          </div>

          <Button type="submit">Send My Request</Button>
          <p class="form-submit-error hidden text-sm font-medium text-bema-green">
            Something went wrong. Please try again or contact us directly at bema.healthalliance@gmail.com.
          </p>
        </form>
        <div class="form-success card mt-8 hidden p-6 text-bema-green" role="status">
          Thank you for reaching out. A member of the BEMA team will be in touch with you shortly using your preferred contact method.
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad bg-bema-khaki-light/20">
    <div class="container">
      <div class="mb-12 max-w-3xl">
        <p class="eyebrow">Questions</p>
        <h2>Questions we hear most often.</h2>
      </div>
      <div class="mx-auto max-w-4xl space-y-4">
        {faqs.map((item) => (
          <details class="card group p-6">
            <summary class="flex cursor-pointer items-center justify-between gap-6">
              <h3 class="text-xl">{item === 1 ? "Who is BEMA for?" : item === 2 ? "Is BEMA insurance?" : item === 3 ? "Do I need to have insurance to join BEMA?" : item === 4 ? "What happens after I sign up?" : "Can my employer offer BEMA to our team?"}</h3>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 flex-none text-bema-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </summary>
            <p class="mt-4 text-bema-green/85">{item === 1 ? "BEMA is for working individuals and families in Florida who earn too much to qualify for Medicaid but cannot absorb what traditional insurance costs today. If you have gone without a primary care doctor because the system made it too expensive or too complicated to access one, BEMA was built for you." : item === 2 ? "No. BEMA is not an insurance company and not an insurance product of any kind. BEMA is a coordination organization. We coordinate access to Direct Primary Care, Eye Care, and Mental Health services through a network of independent partner clinics. You pay a monthly program service fee for coordinated access to that network. There are no claims, no deductibles, and no insurance approval required to get care." : item === 3 ? "No. BEMA membership is open to anyone regardless of insurance status. If you have existing coverage, BEMA works alongside it. If you do not, BEMA stands on its own. The only requirement is that you are a working individual or family in Florida looking for a better way to access care." : item === 4 ? "Once you become a member BEMA connects you to the right partner clinics for your needs and handles the coordination from there. You will know exactly where to go, who to see, and what to expect before your first visit. No runaround, no paperwork maze, no surprise bills." : "Yes. BEMA works with Florida employers who want to extend coordinated healthcare access to their workforce as part of a benefits strategy. Employer memberships operate on the same program service fee model with no claims processing and no administrative burden on the employer. Visit our Employers page to learn more."}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-bema-green py-16 text-bema-white">
    <div class="container">
      <div class="max-w-4xl">
        <h2 class="text-bema-white">The first step is the easiest one you will take.</h2>
        <div class="mt-8">
          <Button href="/contact" variant="inverted">Contact Us</Button>
        </div>
      </div>
    </div>
  </section>

  <script>
    const selectedCardClasses = ["border-bema-green", "bg-bema-green/10"];
    const unselectedRadioClasses = ["border-bema-khaki/60", "bg-bema-white"];
    const selectedContactClasses = ["bg-bema-green", "text-bema-white"];
    const unselectedContactClasses = ["bg-transparent", "text-bema-green"];

    const toggles = document.querySelectorAll<HTMLButtonElement>("[data-form-toggle]");
    const individualWrap = document.querySelector<HTMLElement>("#form-individual");
    const employerWrap = document.querySelector<HTMLElement>("#form-employer");
    const individualForm = document.querySelector<HTMLFormElement>("#individual-get-started-form");
    const employerForm = document.querySelector<HTMLFormElement>("#employer-get-started-form");
    const totalCountWrap = document.querySelector<HTMLElement>("#individual-total-count-wrap");
    const totalCountInput = document.querySelector<HTMLInputElement>("#individual-total-count");

    const setToggleState = (activeType: string) => {
      toggles.forEach((toggle) => {
        const isActive = toggle.dataset.formToggle === activeType;
        toggle.classList.toggle("bg-bema-green", isActive);
        toggle.classList.toggle("text-bema-white", isActive);
        toggle.classList.toggle("bg-transparent", !isActive);
        toggle.classList.toggle("text-bema-green", !isActive);
      });
    };

    const updateRadioCards = (form: HTMLFormElement) => {
      form.querySelectorAll<HTMLLabelElement>(".radio-card").forEach((card) => {
        const input = card.querySelector<HTMLInputElement>('input[type="radio"]');
        const isChecked = Boolean(input?.checked);
        selectedCardClasses.forEach((className) => card.classList.toggle(className, isChecked));
        unselectedRadioClasses.forEach((className) => card.classList.toggle(className, !isChecked));
      });
    };

    const updateContactCards = (form: HTMLFormElement) => {
      form.querySelectorAll<HTMLLabelElement>(".contact-method-card").forEach((card) => {
        const input = card.querySelector<HTMLInputElement>('input[type="checkbox"]');
        const isChecked = Boolean(input?.checked);
        selectedContactClasses.forEach((className) => card.classList.toggle(className, isChecked));
        unselectedContactClasses.forEach((className) => card.classList.toggle(className, !isChecked));
      });
    };

    const resetFormState = (form: HTMLFormElement | null) => {
      if (!form) {
        return;
      }

      form.reset();
      form.classList.remove("hidden");
      form.querySelector<HTMLElement>(".form-submit-error")?.classList.add("hidden");
      form.querySelector<HTMLElement>(".preferred-contact-error")?.classList.add("hidden");
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');

      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Send My Request";
      }

      updateRadioCards(form);
      updateContactCards(form);
      form.parentElement?.querySelector<HTMLElement>(".form-success")?.classList.add("hidden");
    };

    const updateTotalCountVisibility = () => {
      const selected = individualForm?.querySelector<HTMLInputElement>('input[name="who_for"]:checked')?.value;
      const shouldShow = selected === "Child" || selected === "Family";

      totalCountWrap?.classList.toggle("hidden", !shouldShow);
      totalCountWrap?.classList.toggle("block", shouldShow);

      if (totalCountInput) {
        totalCountInput.required = shouldShow;

        if (!shouldShow) {
          totalCountInput.value = "";
        }
      }
    };

    const showFormType = (activeType: string) => {
      const inactiveForm = activeType === "individual" ? employerForm : individualForm;
      resetFormState(inactiveForm);
      setToggleState(activeType);

      individualWrap?.classList.toggle("hidden", activeType !== "individual");
      individualWrap?.classList.toggle("block", activeType === "individual");
      employerWrap?.classList.toggle("hidden", activeType !== "employer");
      employerWrap?.classList.toggle("block", activeType === "employer");
      updateTotalCountVisibility();
    };

    toggles.forEach((toggle) => {
      toggle.addEventListener("click", () => {
        showFormType(toggle.dataset.formToggle || "individual");
      });
    });

    [individualForm, employerForm].forEach((form) => {
      form?.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
        input.addEventListener("change", () => {
          updateRadioCards(form);
          updateTotalCountVisibility();
        });
      });

      form?.querySelectorAll<HTMLInputElement>('input[name="preferred_contact"]').forEach((input) => {
        input.addEventListener("change", () => {
          form.querySelector<HTMLElement>(".preferred-contact-error")?.classList.add("hidden");
          updateContactCards(form);
        });
      });
    });

    const handleFormSubmit = async (form: HTMLFormElement) => {
      const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const submitError = form.querySelector<HTMLElement>(".form-submit-error");
      const preferredContactError = form.querySelector<HTMLElement>(".preferred-contact-error");
      const successMessage = form.parentElement?.querySelector<HTMLElement>(".form-success");
      const preferredContacts = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="preferred_contact"]:checked')).map((input) => input.value);

      submitError?.classList.add("hidden");

      if (preferredContacts.length === 0) {
        preferredContactError?.classList.remove("hidden");
        return;
      }

      preferredContactError?.classList.add("hidden");

      if (!submitButton || !successMessage) {
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Sending...";

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData);
      payload.preferred_contact = preferredContacts.join(", ");

      if (payload.form_type === "individual" && payload.who_for === "Adult") {
        delete payload.total_count;
      }

      try {
        const response = await fetch("/api/get-started", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.message || "Get started form submission failed.");
        }

        form.classList.add("hidden");
        successMessage.classList.remove("hidden");
      } catch {
        submitButton.disabled = false;
        submitButton.textContent = "Send My Request";
        submitError?.classList.remove("hidden");
      }
    };

    individualForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      handleFormSubmit(individualForm);
    });

    employerForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      handleFormSubmit(employerForm);
    });

    showFormType("individual");
  </script>
</BaseLayout>
